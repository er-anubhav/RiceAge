{
  "experiment_name": "EXP_006_TARGETED_DEFECT_IMPROVEMENT",
  "description": "Targeted defect improvement initialized from EXP005 teacher checkpoint. Frozen identity/integrity heads, conservative backbone learning rate (5e-6), defect head learning rate (3e-5), positive-only pseudo-labeling, corrected non-negative PU loss with positive risk preservation, multi-gate validation tracking.",
  "paths": {
    "project_root": "c:/Users/NewGen/Documents/RiceCropAnalyzer",
    "crop_root": "dataset/crops",
    "manifest_path": "outputs/phase2_automated/automated_dataset_manifest.csv",
    "crosswalk_path": "outputs/phase1_2_final_audit/canonical_id_crosswalk.csv",
    "base_checkpoint_path": "outputs/phase2_automated/experiments/exp005_targeted_improvement/latest_training_state.pt",
    "output_dir": "outputs/phase2_automated/experiments/exp006_targeted_defect_improvement"
  },
  "model": {
    "backbone": "resnet50",
    "num_heads": 5,
    "input_size": [128, 128],
    "normalization": {
