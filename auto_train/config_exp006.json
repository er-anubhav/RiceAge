      "chalky": 0.1250,
      "discoloured": 0.0420
    },
    "beta_slack": 0.0
  },
  "pseudo_labeling": {
    "enabled": true,
    "allow_pseudo_negatives": false,
    "tta_views": 3,
    "variance_threshold": 0.010,
    "thresholds": {
      "damaged": {
        "pos": 0.90,
        "neg": null
      },
      "chalky": {
        "pos": 0.92,
        "neg": null
      },
      "discoloured": {
        "pos": 0.80,
        "neg": null
      }
    },
    "max_pseudo_label_fraction": 0.08
  },
  "supervised_weights": {
    "identity_pos_weight": 46.6,
    "integrity_pos_weight": 8.85
  },
  "validation": {
    "scan_cv_guardrail_multiplier": 1.25,
    "scan_cv_absolute_threshold": null,
    "min_val_improvement": 0.001
  }
